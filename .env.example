# =================================================================
# Konfigurasi Firebase untuk Violet Travel Nusantara
# =================================================================
# Panduan mendapatkan kunci di Firebase Console:
# 1. Buka https://console.firebase.google.com/
# 2. Buat / Pilih Project -> Masuk ke "Project Settings" (ikon gerigi)
# 3. Pada tab "General", scroll ke bawah ke bagian "Your apps"
# 4. Klik ikon Web (</>) dan salin konfigurasi `firebaseConfig`:
# =================================================================

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
